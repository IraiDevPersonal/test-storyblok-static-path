---
import { data } from "../pages/propuesta/data";
import { sanitizedCard } from "../lib/utils/sanitized-card";
import type { CardBlok } from "../types/storyblok/test-space";

type Props = {
  blok: CardBlok;
};

const { blok } = Astro.props;
const textComponent = sanitizedCard(blok.content || "");
---

<section class="flex flex-wrap gap-2 justify-center-safe">
  <!-- hidden card para cargar clases de tailwind -->
  <article
    hidden
    aria-hidden="true"
    class="w-full rounded-2xl border border-neutral-700 bg-neutral-900 shadow-lg shadow-neutral-100/5 p-4 space-y-4"
  >
    <header class="flex items-center gap-x-2">
      <img
        src="{{thumbnailUrl}}"
        alt="{{title}}"
        class="size-10 object-cover aspect-square rounded-full"
      />
      <h2 class="text-xl font-semibold"></h2>
    </header>
    <section class="flex gap-x-4">
      <img
        class="size-40 object-center object-cover aspect-square text-neutral-500 text-xs rounded-xl"
      />
      <p class="text-sm text-neutral-400 text-justify">
        lore ipsum dolor sit amet consectetur adipisicing elit, sed do eiusmod
        tempor incididunt ut labore et dolore magna aliqua, Ut enim ad minim
        veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea
        commodo consequat, Duis aute irure dolor in reprehenderit in voluptate
        velit esse cillum dolore eu fugiat nulla pariatur, Excepteur sint
        occaecat cupidatat non proident, sunt in culpa qui officia deserunt
        mollit anim id est laborum.
      </p>
    </section>
  </article>

  {
    data.map((photo) => {
      const component = textComponent
        .replaceAll("{{title}}", photo.title)
        .replace("{{thumbnailUrl}}", photo.thumbnailUrl)
        .replace("{{imageSrc}}", photo.url);

      return <Fragment set:html={component} />;
    })
  }
</section>
