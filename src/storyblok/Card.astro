---
import { data } from "../pages/propuesta/data";
import { sanitizedCard } from "../lib/utils/sanitized-card";
import type { CardBlok } from "../types/storyblok/test-space";

type Props = {
  blok: CardBlok;
};

const { blok } = Astro.props;
const textComponent = sanitizedCard(blok.content || "");
---

<section class="flex flex-wrap gap-2 justify-center-safe">
  {
    data.map((photo) => {
      const component = textComponent
        .replaceAll("{{title}}", photo.title)
        .replace("{{thumbnailUrl}}", photo.thumbnailUrl)
        .replace("{{imageSrc}}", photo.url);

      return <Fragment set:html={component} />;
    })
  }
</section>
