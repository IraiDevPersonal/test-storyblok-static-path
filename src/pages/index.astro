---
import RootLayout from "../components/layouts/RootLayout.astro";
import Counter from "../components/ui/Counter.astro";
import Link from "../components/ui/Link.astro";
---

<RootLayout title="/">
  <main class="min-h-screen bg-linear-to-b from-zinc-950 via-black to-zinc-950">
    <div
      class="mx-auto flex flex-col gap-y-4 min-h-screen max-w-5xl items-center px-6 py-16"
    >
      <section class="w-full">
        <div
          class="rounded-2xl border border-white/10 bg-white/5 p-8 shadow-[0_0_0_1px_rgba(255,255,255,0.04)_inset] backdrop-blur sm:p-10"
        >
          <div class="flex flex-col gap-6">
            <header class="flex flex-col gap-3">
              <p class="text-xs font-medium tracking-wide text-white/60">
                Astro + Storyblok
              </p>
              <h1
                class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
              >
                Static paths playground
              </h1>
              <p class="max-w-2xl text-sm leading-6 text-white/70 sm:text-base">
                Un punto de entrada simple para navegar al sitio y validar el
                build de rutas estáticas.
              </p>
            </header>

            <nav aria-label="Primary">
              <ul class="flex flex-col gap-2 sm:flex-row sm:gap-3">
                <li>
                  <Link href="/home" label="Home" />
                </li>
                <li>
                  <Link href="/about" label="About" />
                </li>
              </ul>
            </nav>

            <div class="grid gap-3 sm:grid-cols-3">
              <div class="rounded-xl border border-white/10 bg-black/30 p-4">
                <p class="text-sm font-medium text-white">Rutas</p>
                <p class="mt-1 text-sm text-white/60">
                  Revisa el árbol de navegación generado.
                </p>
              </div>
              <div class="rounded-xl border border-white/10 bg-black/30 p-4">
                <p class="text-sm font-medium text-white">Contenido</p>
                <p class="mt-1 text-sm text-white/60">
                  Valida el fetch y el render de Storyblok.
                </p>
              </div>
              <div class="rounded-xl border border-white/10 bg-black/30 p-4">
                <p class="text-sm font-medium text-white">Build</p>
                <p class="mt-1 text-sm text-white/60">
                  Comprueba que las static paths salen bien.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <Counter />
    </div>
  </main>
</RootLayout>
