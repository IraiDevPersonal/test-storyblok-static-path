export const prerender = true;

const storyblokApi = useStoryblokApi();

const { data } = await storyblokApi.get("cdn/stories/cards", {
  version: IS_PREVIEW ? "draft" : "published",
});
---

<RootLayout title="Propuesta">
  <main
    class="min-h-screen bg-linear-to-b from-zinc-950 via-black to-zinc-950 mx-auto flex flex-col gap-y-4 max-w-5xl items-center px-6 py-16"
  >
    <header class="flex items-center gap-x-2">
      <BackButton />
      <h1 class="text-3xl font-bold">Propuesta Cards dinamicas</h1>
    </header>

    <StoryblokComponent blok={data.story.content} />
  </main>
</RootLayout>
